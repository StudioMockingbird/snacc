type UserId is Int64

type Point is struct
    x: Dec64,
    y: Dec64,
end

type Marker is struct end

type Shape is union
    | Circle is struct
        radius: Int64,
      end
    | Rectangle is struct
        length: Int64,
        width: Int64,
      end
end

type MaybeUser is union
    | User is struct
        id: UserId,
      end
    | Nil
end

method Point.length_squared(): Dec64 do
    self.x * self.x + self.y * self.y
end

method Point.translate(dx: Dec64, dy: Dec64) do
    self.x = self.x + dx
    self.y = self.y + dy
end

method Point.reset() do
    self = Point(x: 0.0, y: 0.0)
end

method Shape.Circle.area(): Int64 do
    self.radius * self.radius
end

// An exhaustive type-test chain produces a value without an `else`.
fun area(shape: Shape): Int64 do
    if shape is Shape.Circle(circle) then
        circle.area()
    elseif shape is Shape.Rectangle(rectangle) then
        rectangle.length * rectangle.width
    end
end

fun describe(user: MaybeUser) do
    if user is MaybeUser.User(present) then
        print(Int64(present.id))
    elseif user is Nil then
        print(0)
    end
end

let mut point: Point = Point(y: 4.0, x: 3.0,)
point.translate(1.0, 2.0)
point.x = 5.0
print(point.length_squared())
point.reset()

let marker: Marker = Marker()
let id: UserId = UserId(42)
print(Int64(id))

print(area(Shape.Circle(radius: 10)))
print(area(Shape.Rectangle(length: 2, width: 3)))

describe(nil)
describe(MaybeUser.User(id: UserId(7)))
