// RFC 015 conformance 5-6: a self-recursive method that writes through
// 'self' still requires a mutable receiver root at the original call site.
// The write happens after the recursive call, not before it, so this proves
// the ordinary receiver-mutability diagnostic fires through a recursive body
// rather than only through a straight-line one.
type RecPoint is struct
    x: Int64,
end

method RecPoint.rec_bump(times: Int64) do
    if times > 0 then
        self.rec_bump(times - 1)
        self.x = self.x + 1
    end
end

let point: RecPoint = RecPoint(x: 0)
point.rec_bump(3)
