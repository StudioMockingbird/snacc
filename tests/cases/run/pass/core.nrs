fun double(value: Int64): Int64 do
    value * 2
end

fun zero_from_loop(value: Int64): Int64 do
    while false do value end
end

print(1 + 2)
print(2.5)
print(nil)
print(3 * 4)
print(5 > 2)
print(double(6))
print(if 1 == 1 then 10 else 20 end)
print(while false do 7 end)
while false do print(99) end
print(11)
print(zero_from_loop(3))
