// RFC 015 conformance 1-5, executed through a real compiled program. The
// negative diagnostic conformance (item 6) lives in the typecheck corpus, and
// the absence of a termination requirement (item 7) is a documentation-only
// claim that cannot be a passing run case.

// Conformance 4: a forward recursive call. The callee is declared later in
// this file, and declaration collection resolves it independent of source
// order.
fun rec_forward_caller(n: Int64): Int64 do
    rec_forward_callee(n)
end

fun rec_forward_callee(n: Int64): Int64 do
    n + 1
end

// Conformance 1: direct result-producing recursion.
fun rec_factorial(n: Int64): Int64 do
    if n == 0 then
        1
    else
        n * rec_factorial(n - 1)
    end
end

// Conformance 2: mutual result-producing recursion.
fun rec_even(n: Int64): Bool do
    if n == 0 then true else rec_odd(n - 1) end
end

fun rec_odd(n: Int64): Bool do
    if n == 0 then false else rec_even(n - 1) end
end

// Conformance 3: direct no-result recursion, terminating via a counted
// decrement so this remains a `run/pass` case rather than an infinite loop.
fun rec_countdown(n: Int64) do
    if n > 0 then
        print(n)
        rec_countdown(n - 1)
    end
end

type RecCounter is struct
    value: Int64,
end

// Conformance 5: mutually recursive methods whose receiver-write effect
// crosses the call-graph cycle. Neither method's direct body write is visible
// to the other without the least-fixed-point analysis, so both must be seen
// as receiver-writing, and the call site below must accept a mutable root.
method RecCounter.rec_bump_via_other(times: Int64) do
    if times > 0 then
        self.rec_bump_direct(times - 1)
    end
end

method RecCounter.rec_bump_direct(times: Int64) do
    if times > 0 then
        self.value = self.value + 1
        self.rec_bump_via_other(times - 1)
    end
end

print(rec_forward_caller(4))
print(rec_factorial(5))
print(rec_even(10))
print(rec_odd(10))
rec_countdown(3)

let mut rec_counter: RecCounter = RecCounter(value: 0)
rec_counter.rec_bump_via_other(4)
print(rec_counter.value)
